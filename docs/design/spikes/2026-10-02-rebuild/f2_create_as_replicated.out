-- projections: does ATTACH PARTITION FROM require identical projections?
CREATE TABLE f.pa (id UInt64, v UInt64) ENGINE = MergeTree ORDER BY id;
INSERT INTO f.pa SELECT number, number FROM numbers(100);
CREATE TABLE f.pb (id UInt64, v UInt64, PROJECTION p (SELECT * ORDER BY v)) ENGINE = MergeTree ORDER BY id;
ALTER TABLE f.pb ATTACH PARTITION tuple() FROM f.pa;
SELECT 'proj-mismatch attach rows', count() FROM f.pb;
