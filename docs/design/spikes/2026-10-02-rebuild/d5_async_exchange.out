> DROP DATABASE IF EXISTS d5 SYNC
> CREATE DATABASE d5
> CREATE TABLE d5.t (id UInt64) ENGINE = MergeTree ORDER BY id
> CREATE TABLE d5.t_new (id UInt64) ENGINE = MergeTree ORDER BY (intHash32(id), id)
> CREATE MATERIALIZED VIEW d5.t_dual TO d5.t_new AS SELECT id FROM d5.t
> INSERT INTO d5.t SETTINGS async_insert = 1, async_insert_use_adaptive_busy_timeout = 0, async_insert_busy_timeout_ms = 8000, async_insert_busy_timeout_max_ms = 8000, wait_for_async_insert = 0 VALUES (1),(2),(3)
> [background] INSERT INTO d5.t SETTINGS async_insert = 1, async_insert_use_adaptive_busy_timeout = 0, async_insert_busy_timeout_ms = 8000, async_insert_busy_timeout_max_ms = 8000, wait_for_async_insert = 1 VALUES (4),(5)
