=== D5c: is an in-progress AsyncInsertFlush visible in system.processes? ===
> CREATE TABLE d5.slow_src (id UInt64) ENGINE = MergeTree ORDER BY id
> CREATE TABLE d5.slow_dst (id UInt64) ENGINE = MergeTree ORDER BY id
> CREATE MATERIALIZED VIEW d5.slow_mv TO d5.slow_dst AS SELECT id FROM d5.slow_src WHERE sleepEachRow(0.5) = 0
> INSERT INTO d5.slow_src SETTINGS async_insert = 1, async_insert_use_adaptive_busy_timeout = 0, async_insert_busy_timeout_ms = 8000, async_insert_busy_timeout_max_ms = 8000, wait_for_async_insert = 0 VALUES (1),(2),(3),(4),(5),(6)
> SELECT query_kind, round(elapsed, 2) AS elapsed, is_initial_query, substr(query, 1, 50) AS q FROM system.processes WHERE query_kind != 'Select'
   ┌─query_kind───────┬─elapsed─┬─is_initial_query─┬─q──────────────────────────────────────────────────┐
