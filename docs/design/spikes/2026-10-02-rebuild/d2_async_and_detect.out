> DROP DATABASE IF EXISTS d2 SYNC
> CREATE DATABASE d2
> CREATE TABLE d2.t (id UInt64) ENGINE = MergeTree ORDER BY id
> CREATE TABLE d2.t_new (id UInt64) ENGINE = MergeTree ORDER BY id
> INSERT INTO d2.t SETTINGS async_insert = 1, wait_for_async_insert = 0, async_insert_use_adaptive_busy_timeout = 0, async_insert_busy_timeout_ms = 15000, async_insert_busy_timeout_max_ms = 15000 VALUES (1),(2),(3)
> SELECT database, table, first_update, total_bytes, length(entries.query_id) AS entries FROM system.asynchronous_inserts
   ┌─database─┬─table─┬───────────────first_update─┬─total_bytes─┬─entries─┐
1. │ d2       │ t     │ 2026-10-02 14:36:52.326712 │          11 │       1 │
   └──────────┴───────┴────────────────────────────┴─────────────┴─────────┘
> SELECT count() AS t_rows FROM d2.t
   ┌─t_rows─┐
1. │      0 │
   └────────┘
> [10:36:37] creating MV while async buffer pending
> CREATE MATERIALIZED VIEW d2.t_dual TO d2.t_new AS SELECT id FROM d2.t
> SYSTEM FLUSH ASYNC INSERT QUEUE
> SELECT (SELECT count() FROM d2.t) AS t_rows, (SELECT count() FROM d2.t_new) AS t_new_rows_via_mv
   ┌─t_rows─┬─t_new_rows_via_mv─┐
1. │      3 │                 3 │
   └────────┴───────────────────┘

=== D3: detection via query_log QueryStart.tables (cascade insert through an upstream MV) ===
> CREATE TABLE d2.feeder (id UInt64) ENGINE = MergeTree ORDER BY id
> CREATE MATERIALIZED VIEW d2.mv_feed TO d2.t AS SELECT id FROM d2.feeder
> SYSTEM FLUSH LOGS
> SELECT type, query_id, tables, query_kind FROM system.query_log WHERE query_id = 'd3-cascade'
   ┌─type───────┬─query_id───┬─tables────────────────────────────────────────────────────┬─query_kind─┐
1. │ QueryStart │ d3-cascade │ ['_table_function.numbers','d2.feeder','d2.t','d2.t_new'] │ Insert     │
   └────────────┴────────────┴───────────────────────────────────────────────────────────┴────────────┘
> SELECT query_id, query_kind, substr(query, 1, 30) q FROM system.processes WHERE query_kind = 'Insert'
   ┌─query_id───┬─query_kind─┬─q──────────────────────────────┐
1. │ d3-cascade │ Insert     │ INSERT INTO d2.feeder SELECT n │
   └────────────┴────────────┴────────────────────────────────┘
> SYSTEM FLUSH LOGS
> SELECT type, query_id, tables FROM system.query_log WHERE query_id = 'd3-cascade'
