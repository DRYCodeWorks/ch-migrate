-- MOVE between different engine families
CREATE TABLE it_spike_b.p_mt (id UInt64, ts DateTime, payload String) ENGINE = MergeTree PARTITION BY toYYYYMM(ts) ORDER BY id;
CREATE TABLE it_spike_b.p_rmt (id UInt64, ts DateTime, payload String) ENGINE = ReplacingMergeTree PARTITION BY toYYYYMM(ts) ORDER BY id;
INSERT INTO it_spike_b.p_mt VALUES (1, '2026-01-05', 'a');
ALTER TABLE it_spike_b.p_mt MOVE PARTITION 202601 TO TABLE it_spike_b.p_rmt;
SELECT 'MT->RMT move', (SELECT count() FROM it_spike_b.p_mt), (SELECT count() FROM it_spike_b.p_rmt);
   ┌─'MT->RMT move'─┬─_subquery_1─┬─_subquery_2─┐
1. │ MT->RMT move   │           0 │           1 │
   └────────────────┴─────────────┴─────────────┘
-- REPLACE PARTITION (idempotent overwrite)
CREATE TABLE it_spike_b.p_rep AS it_spike_b.p_mt;
INSERT INTO it_spike_b.p_mt VALUES (2, '2026-01-06', 'it_spike_b');
ALTER TABLE it_spike_b.p_rep REPLACE PARTITION 202601 FROM it_spike_b.p_mt;
ALTER TABLE it_spike_b.p_rep REPLACE PARTITION 202601 FROM it_spike_b.p_mt;
SELECT 'REPLACE twice', count() FROM it_spike_b.p_rep;
