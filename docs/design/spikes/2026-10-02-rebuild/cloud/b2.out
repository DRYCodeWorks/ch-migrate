SET send_logs_level = 'none';
-- Unpartitioned (PARTITION BY tuple())
CREATE TABLE it_spike_b.u (id UInt64, v String) ENGINE = MergeTree ORDER BY id;
INSERT INTO it_spike_b.u SELECT number, toString(number) FROM numbers(1000);
INSERT INTO it_spike_b.u SELECT number, toString(number) FROM numbers(1000, 1000);
SELECT partition, partition_id, count() FROM system.parts WHERE database='it_spike_b' AND table='u' AND active GROUP BY ALL;
   ┌─partition─┬─partition_id─┬─count()─┐
1. │ tuple()   │ all          │       2 │
   └───────────┴──────────────┴─────────┘
CREATE TABLE it_spike_b.u_snap AS it_spike_b.u;
ALTER TABLE it_spike_b.u_snap ATTACH PARTITION tuple() FROM it_spike_b.u;
SELECT 'u_snap after tuple()', count() FROM it_spike_b.u_snap;
   ┌─'u_snap after tuple()'─┬─count()─┐
1. │ u_snap after tuple()   │    2000 │
   └────────────────────────┴─────────┘
CREATE TABLE it_spike_b.u_snap2 AS it_spike_b.u;
ALTER TABLE it_spike_b.u_snap2 ATTACH PARTITION ID 'all' FROM it_spike_b.u;
SELECT 'u_snap2 after ID all', count() FROM it_spike_b.u_snap2;
   ┌─'u_snap2 after ID all'─┬─count()─┐
1. │ u_snap2 after ID all   │    2000 │
   └────────────────────────┴─────────┘
CREATE TABLE it_spike_b.u_snap3 AS it_spike_b.u;
ALTER TABLE it_spike_b.u_snap3 ATTACH PARTITION ALL FROM it_spike_b.u;
SELECT 'u_snap3 after ALL', count() FROM it_spike_b.u_snap3;
   ┌─'u_snap3 after ALL'─┬─count()─┐
1. │ u_snap3 after ALL   │    2000 │
   └─────────────────────┴─────────┘
-- ALL on a partitioned table
CREATE TABLE it_spike_b.t_all AS it_spike_b.t;
ALTER TABLE it_spike_b.t_all ATTACH PARTITION ALL FROM it_spike_b.t;
SELECT 't_all after ATTACH PARTITION ALL', count() FROM it_spike_b.t_all;
   ┌─'t_all after ATTACH PARTITION ALL'─┬─count()─┐
1. │ t_all after ATTACH PARTITION ALL   │       0 │
   └────────────────────────────────────┴─────────┘
-- MOVE PARTITION TO TABLE (MergeTree -> MergeTree)
CREATE TABLE it_spike_b.u_stage AS it_spike_b.u;
INSERT INTO it_spike_b.u_stage SELECT number + 10000, 'staged' FROM numbers(500);
CREATE TABLE it_spike_b.u_dest AS it_spike_b.u;
INSERT INTO it_spike_b.u_dest SELECT number + 20000, 'mv-written' FROM numbers(7);
ALTER TABLE it_spike_b.u_stage MOVE PARTITION tuple() TO TABLE it_spike_b.u_dest;
SELECT 'after MOVE tuple()', (SELECT count() FROM it_spike_b.u_stage) AS stage, (SELECT count() FROM it_spike_b.u_dest) AS dest;
   ┌─'after MOVE tuple()'─┬─stage─┬─dest─┐
1. │ after MOVE tuple()   │     0 │  507 │
   └──────────────────────┴───────┴──────┘
INSERT INTO it_spike_b.u_stage SELECT number + 30000, 'staged2' FROM numbers(5);
ALTER TABLE it_spike_b.u_stage MOVE PARTITION ALL TO TABLE it_spike_b.u_dest;
